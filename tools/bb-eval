#!/usr/bin/env bash
#
# bb-eval — score a bb-browser adapter against the contract for its domain.
#
# Usage:
#   bb-eval <path-to-adapter.js> [--domain ecommerce|pharma-data|social-media]
#   bb-eval <path-to-adapter.js> --json
#
# Exit code: 0 if all FAIL checks pass, 1 otherwise.
# WARNs do not affect exit code.
#
# This is a STATIC checker. It reads the adapter source and its @meta block.
# It does NOT execute the adapter. To execute, use bb-browser MCP separately.
#
# Check families:
#   (cross-domain)  URL constant, @meta fields, error envelope, pagination, nextActions
#   PHR-*           pharma-data specific
#   SOC-*           social-media specific
#
set -u

ADAPTER=""
DOMAIN=""
JSON_OUT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --domain) DOMAIN="$2"; shift 2 ;;
    --json) JSON_OUT=1; shift ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) ADAPTER="$1"; shift ;;
  esac
done

if [[ -z "$ADAPTER" ]]; then
  echo "usage: bb-eval <path-to-adapter.js> [--domain ecommerce] [--json]" >&2
  exit 2
fi

if [[ ! -f "$ADAPTER" ]]; then
  echo "bb-eval: not a file: $ADAPTER" >&2
  exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "bb-eval: jq is required but not installed" >&2
  exit 2
fi

# ----- accumulators -----
declare -a RESULTS  # each entry: "LEVEL\tCHECK\tMESSAGE"
PASS=0; WARN=0; FAIL=0

record() {
  local level="$1" check="$2" msg="$3"
  RESULTS+=("${level}"$'\t'"${check}"$'\t'"${msg}")
  case "$level" in
    PASS) PASS=$((PASS+1)) ;;
    WARN) WARN=$((WARN+1)) ;;
    FAIL) FAIL=$((FAIL+1)) ;;
  esac
}

# ----- Read source + extract @meta -----
SRC="$(cat "$ADAPTER")"
META_JSON="$(printf '%s' "$SRC" \
  | awk 'BEGIN{found=0; depth=0; out=""}
         /\/\* @meta/ {found=1; next}
         found {
           # collect until closing */
           if (match($0, /\*\//)) {
             out = out substr($0, 1, RSTART-1)
             print out
             exit
           } else {
             out = out $0 "\n"
           }
         }')"

if [[ -z "$META_JSON" ]]; then
  record FAIL meta-block "Missing /* @meta { ... } */ block at top of adapter file."
else
  if ! printf '%s' "$META_JSON" | jq -e . >/dev/null 2>&1; then
    record FAIL meta-block-valid "@meta block is not valid JSON."
    META_JSON=""
  else
    record PASS meta-block-valid "@meta block parses as JSON."
  fi
fi

meta_get() {
  printf '%s' "$META_JSON" | jq -r "$1" 2>/dev/null
}

# Check if a top-level @meta field exists (not null), even if its value is false/0/""
meta_has() {
  local key="$1"
  printf '%s' "$META_JSON" | jq -e --arg k "$key" 'has($k) and (.[$k] != null)' >/dev/null 2>&1
}

# ----- Domain detection -----
NAME="$(meta_get '.name')"
META_DOMAIN="$(meta_get '.domain')"
ADAPTER_LOCAL="${NAME##*/}"

# ----- Syntax check (Check 0) — runs FIRST so subsequent checks have a valid source -----
# Mirrors the REAL runtime (bb-browser site.ts): the first /* @meta ... */ block is
# stripped and the remaining body is evaluated as ONE expression, (body)(args).
# So the body must compile as a single expression: top-level `const`, extra
# statements, or `module.exports = ...` all throw SyntaxError at runtime even
# though `node --check` (standalone module parse) blesses them. The previous
# node --check gate had the verdict inverted (SM-2.8 correction, 2026-09-07).
if command -v node >/dev/null 2>&1; then
  SYNTAX_ERR="$(node -e '
    const fs = require("fs"), vm = require("vm");
    const src = fs.readFileSync(process.argv[1], "utf8");
    const body = src.replace(/\/\*\s*@meta[\s\S]*?\*\//, "").trim();
    try {
      new vm.Script("(" + body + ")");
    } catch (e) {
      console.error((e && e.message) ? e.message : String(e));
      process.exit(1);
    }
  ' "$ADAPTER" 2>&1)"
  if [[ -n "$SYNTAX_ERR" ]]; then
    record FAIL "syntax-check" "Body does not compile as a single runtime expression — runtime evals (body)(args), so top-level statements / multiple functions / module.exports are fatal: ${SYNTAX_ERR}"
  else
    record PASS "syntax-check" "Body compiles as a single runtime expression (matches bb-browser site.ts eval semantics)."
  fi
  unset SYNTAX_ERR
else
  record WARN "syntax-check" "node binary not found; cannot run syntax check."
fi

# ----- Check 0.5: no ghost API calls -----
# The runtime injects no `bb` global (site.ts / site-runner.ts both evaluate
# `(body)(args)` in the raw page context). bb.goto/bb.eval/bb.fetch and the
# page-handle chain they returned were a phantom API — any real call throws
# ReferenceError in production (soul.md 2026-09-07). Comment mentions are fine.
if command -v node >/dev/null 2>&1; then
  GHOST_HITS="$(node -e '
    const fs = require("fs");
    const NL = String.fromCharCode(10);
    const lines = fs.readFileSync(process.argv[1], "utf8").split(NL);
    const re = /(^|[^.\w])(?:await\s+)?(?:bb|page|probe|here)\.(goto|eval|evaluate|wait|\$eval|\$\$eval)\s*\(/;
    const hits = [];
    lines.forEach((ln, i) => {
      if (/^\s*(\*|\/\/)/.test(ln)) return;
      const t = ln.replace(/\/\/.*$/, "");
      if (re.test(t)) hits.push((i + 1) + ": " + ln.trim().slice(0, 60));
    });
    process.stdout.write(hits.slice(0, 3).join(NL));
  ' "$ADAPTER")"
  if [[ -n "$GHOST_HITS" ]]; then
    record FAIL "no-ghost-api" "Adapter calls the phantom bb.*/page.* API (no bb global exists at runtime): $GHOST_HITS"
  else
    record PASS "no-ghost-api" "No phantom bb.*/page.* calls."
  fi
  unset GHOST_HITS
fi

if [[ -z "$DOMAIN" ]]; then
  # Domain detection. @meta.domain is used inconsistently across the codebase:
  #   - pharma-data / social-media adapters set it to the contract name ("pharma-data", "social-media")
  #   - ecommerce adapters set it to a hostname ("s.1688.com")
  # So: first honor explicit contract-name values, then fall back to hostname heuristics
  # on both @meta.domain and @meta.name.
  case "$META_DOMAIN" in
    ecommerce|pharma-data|social-media) DOMAIN="$META_DOMAIN" ;;
  esac

  if [[ -z "$DOMAIN" ]]; then
    # Hostname heuristics — check both domain and name fields.
    HAYSTACK="${META_DOMAIN} ${NAME}"
    case "$HAYSTACK" in
      *yaozh.com*|*data.yaozh.com*|*yaozh/*) DOMAIN=pharma-data ;;
      *xiaohongshu*|*xhs*|*xhslink*|*twitter.com*|*x.com*|*twitter/*|*bilibili*|*b23.tv*|*bilibili/*|*discord.com*|*discord.gg*|*discord/*|*telegram*|*t.me*) DOMAIN=social-media ;;
      *ysbang*|*1688*|*ybm100.com*|*jd.com*|*pdd.com*|*taobao.com*|*111.com.cn*|*1yaocheng*|*tmall*|*yaoex*|*fangkuaiyi*) DOMAIN=ecommerce ;;
      *) DOMAIN=unknown ;;
    esac
  fi
fi

# ----- Code window: first 50 lines AFTER the @meta block -----
# The URL-constant rule counts CODE lines, not front matter: June-29 files carry
# @disclaimer headers + expanded @meta that alone exceed 50 physical lines.
meta_end_line="$(awk '/\/\* *@meta/{f=1} f && /\*\//{print NR; exit}' "$ADAPTER")"
if [[ -n "$meta_end_line" ]]; then
  CODE_WINDOW="$(sed -n "$((meta_end_line + 1)),$((meta_end_line + 50))p" "$ADAPTER")"
else
  CODE_WINDOW="$(head -n 50 "$ADAPTER")"
fi

# ----- PHR-1: domain must be pharma-data if --domain pharma-data -----
if [[ "$DOMAIN" == "pharma-data" ]]; then
  META_DOMAIN_VAL="$(meta_get '.domain')"
  if [[ "$META_DOMAIN_VAL" == "pharma-data" ]]; then
    record PASS "PHR-1 domain-set" "@meta.domain is 'pharma-data'."
  else
    record FAIL "PHR-1 domain-set" "@meta.domain must be 'pharma-data', got: ${META_DOMAIN_VAL:-empty}"
  fi
fi

# ----- PHR-2: dbkey declared -----
if [[ "$DOMAIN" == "pharma-data" ]]; then
  DBKEY="$(meta_get '.dbKey')"
  if [[ -n "$DBKEY" && "$DBKEY" != "null" ]]; then
    record PASS "PHR-2 dbkey-declared" "@meta.dbKey is '${DBKEY}'."
  else
    record FAIL "PHR-2 dbkey-declared" "@meta.dbKey is missing."
  fi
fi

# ----- PHR-4: list and item exported (skip for helpers) -----
if [[ "$DOMAIN" == "pharma-data" ]]; then
  KIND="$(meta_get '.kind')"
  if [[ "$KIND" == "helper" ]]; then
    record PASS "PHR-4 helper-structure" "Helper adapter (kind: helper) does not require list/item."
  else
    if grep -q "async function list\b" "$ADAPTER"; then
      record PASS "PHR-4 list-function" "Adapter exports a 'list' function."
    else
      record FAIL "PHR-4 list-function" "Adapter must export an 'async function list'."
    fi
    if grep -q "async function item\b" "$ADAPTER"; then
      record PASS "PHR-4 item-function" "Adapter exports an 'item' function."
    else
      record FAIL "PHR-4 item-function" "Adapter must export an 'async function item'."
    fi
  fi
fi

# ----- PHR-5: record shape (skip for helpers) -----
if [[ "$DOMAIN" == "pharma-data" && "$KIND" != "helper" ]]; then
  if { grep -Eq "\bdbKey[:,]" "$ADAPTER" || grep -q "dbKey\b" "$ADAPTER"; } \
      && { grep -Eq "\bid[:,]" "$ADAPTER" || grep -q "\bid\b" "$ADAPTER"; } \
      && { grep -Eq "\burl:" "$ADAPTER" || grep -q "\burl[,}]" "$ADAPTER"; } \
      && { grep -Eq "\bfields[:,]" "$ADAPTER" || grep -q "fields\b" "$ADAPTER"; }; then
    record PASS "PHR-5 record-shape" "Adapter return contains dbKey, id, url, fields keys."
  else
    record FAIL "PHR-5 record-shape" "Adapter must return Record objects with dbKey, id, url, fields."
  fi
fi

# ----- PHR-6: ID discriminator (skip for helpers) -----
if [[ "$DOMAIN" == "pharma-data" && "$KIND" != "helper" ]]; then
  if grep -qE "(isNumeric|isBase64|/\\^\?\\\\d\\+\\\$/|\\.test\\(.*\\d|Number\\(.*id|base64.*test|test.*base64)" "$ADAPTER"; then
    record PASS "PHR-6 id-detect" "item() function contains ID-type discrimination logic."
  else
    record WARN "PHR-6 id-detect" "item() should detect numeric vs base64 ID format. Static check cannot verify runtime behavior."
  fi
fi

# ----- PHR-7: authStatus field (skip for helpers) -----
if [[ "$DOMAIN" == "pharma-data" && "$KIND" != "helper" ]]; then
  if grep -q "authStatus" "$ADAPTER"; then
    record PASS "PHR-7 auth-status" "Adapter returns authStatus field."
  else
    record FAIL "PHR-7 auth-status" "Every Record/Detail must include authStatus: 'public'|'soft_vip'|'hard_wall'."
  fi
fi

# ----- PHR-8: canonical adapter names -----
if [[ "$DOMAIN" == "pharma-data" ]]; then
  case "$ADAPTER_LOCAL" in
    auth|list|item|search|export|related|yaozh-auth)
      record PASS "PHR-8 canonical-name" "'${ADAPTER_LOCAL}' is a canonical pharma-data adapter name." ;;
    *-list|*-detail|*-list.js|*-detail.js)
      record FAIL "PHR-8 canonical-name" "Adapter names like '${ADAPTER_LOCAL}' are forbidden. One adapter per dbKey, exporting list()+item()." ;;
    *)
      record WARN "PHR-8 canonical-name" "'${ADAPTER_LOCAL}' is not in the canonical P0/P1 set for pharma-data." ;;
  esac
fi

# ----- PHR-9: helper kind declaration -----
if [[ "$DOMAIN" == "pharma-data" && "$ADAPTER_LOCAL" == "yaozh-auth" ]]; then
  KIND="$(meta_get '.kind')"
  if [[ "$KIND" == "helper" ]]; then
    record PASS "PHR-9 helper-name" "yaozh-auth declares kind: 'helper'."
  else
    record FAIL "PHR-9 helper-name" "Cross-cutting helper 'yaozh-auth' must set @meta.kind to 'helper'."
  fi
fi

# ----- PHR-10: no hardcoded credentials -----
if [[ "$DOMAIN" == "pharma-data" ]]; then
  if grep -qP "(password\s*=|passwd\s*=|api_key\s*=|secret\s*=|Bearer\s+[A-Za-z0-9+/=]{20,})" "$ADAPTER"; then
    record FAIL "PHR-10 no-creds" "Adapter source may contain hardcoded credentials. Remove or read from env."
  else
    record PASS "PHR-10 no-creds" "No hardcoded credentials detected."
  fi
fi

# ===========================================================================
# social-media domain checks (SOC-* family)
# Mirrors the PHR-* structure. Active only when DOMAIN == social-media.
# ===========================================================================

# ----- SOC-1: domain must be social-media -----
if [[ "$DOMAIN" == "social-media" ]]; then
  META_DOMAIN_VAL="$(meta_get '.domain')"
  if [[ "$META_DOMAIN_VAL" == "social-media" ]]; then
    record PASS "SOC-1 domain-set" "@meta.domain is 'social-media'."
  else
    record FAIL "SOC-1 domain-set" "@meta.domain must be 'social-media', got: ${META_DOMAIN_VAL:-empty}"
  fi
fi

# ----- SOC-2: accessTier declared and in enum -----
if [[ "$DOMAIN" == "social-media" ]]; then
  ACCESS_TIER="$(meta_get '.accessTier')"
  case "$ACCESS_TIER" in
    anonymous|auth_read|auth_write)
      record PASS "SOC-2 access-tier" "@meta.accessTier is '${ACCESS_TIER}'." ;;
    *)
      record FAIL "SOC-2 access-tier" "@meta.accessTier must be one of anonymous|auth_read|auth_write, got: ${ACCESS_TIER:-empty}" ;;
  esac
fi

# ----- SOC-3: intent declared and in enum -----
if [[ "$DOMAIN" == "social-media" ]]; then
  INTENT="$(meta_get '.intent')"
  case "$INTENT" in
    discover|consume|engage|create|manage)
      record PASS "SOC-3 intent" "@meta.intent is '${INTENT}'." ;;
    *)
      record FAIL "SOC-3 intent" "@meta.intent must be one of discover|consume|engage|create|manage, got: ${INTENT:-empty}" ;;
  esac
fi

# ----- SOC-4: adapter-name <-> intent consistency -----
# feed/search accept discover OR consume (boundary blurs on simplified sites).
# Other adapters have a single expected intent.
if [[ "$DOMAIN" == "social-media" ]]; then
  case "$ADAPTER_LOCAL" in
    feed|search)   EXPECTED_INTENT="discover|consume" ;;
    post-detail|comments|user|user-notes|notifications|unread) EXPECTED_INTENT="consume" ;;
    like|favorite|comment-post|follow) EXPECTED_INTENT="engage" ;;
    post-create)   EXPECTED_INTENT="create" ;;
    auth|post-delete|comment-delete) EXPECTED_INTENT="manage" ;;
    dm-list|follower-list|follow-list) EXPECTED_INTENT="consume" ;;
    dm-send)       EXPECTED_INTENT="engage" ;;
    *)             EXPECTED_INTENT="" ;;
  esac
  if [[ -z "$EXPECTED_INTENT" ]]; then
    record WARN "SOC-4 intent-name" "'${ADAPTER_LOCAL}' is not in the canonical set; cannot verify intent mapping."
  else
    # multi-allowed (feed/search) uses | delimiter; check membership
    if [[ "$EXPECTED_INTENT" == *"|"* ]]; then
      if [[ " ${EXPECTED_INTENT//|/ } " == *" $INTENT "* ]]; then
        record PASS "SOC-4 intent-name" "@meta.intent '${INTENT}' is valid for '${ADAPTER_LOCAL}'."
      else
        record FAIL "SOC-4 intent-name" "@meta.intent for '${ADAPTER_LOCAL}' must be one of [${EXPECTED_INTENT}], got: ${INTENT:-empty}"
      fi
    else
      if [[ "$INTENT" == "$EXPECTED_INTENT" ]]; then
        record PASS "SOC-4 intent-name" "@meta.intent '${INTENT}' matches '${ADAPTER_LOCAL}'."
      else
        record FAIL "SOC-4 intent-name" "@meta.intent for '${ADAPTER_LOCAL}' must be '${EXPECTED_INTENT}', got: ${INTENT:-empty}"
      fi
    fi
  fi
fi

# ----- SOC-5: readOnly <-> write/read consistency -----
if [[ "$DOMAIN" == "social-media" && -n "$META_JSON" ]]; then
  RO="$(meta_get '.readOnly')"
  case "$ADAPTER_LOCAL" in
    like|favorite|comment-post|follow|post-create|post-delete|comment-delete|dm-send)
      # write adapters
      if [[ "$RO" == "true" ]]; then
        record FAIL "SOC-5 readonly-mismatch" "Write adapter '${ADAPTER_LOCAL}' must declare readOnly: false, got: ${RO:-empty}"
      else
        record PASS "SOC-5 readonly-mismatch" "Write adapter '${ADAPTER_LOCAL}' declares readOnly: false."
      fi
      # write adapters must also be accessTier auth_write
      if [[ "$ACCESS_TIER" != "auth_write" ]]; then
        record FAIL "SOC-5 write-tier" "Write adapter '${ADAPTER_LOCAL}' must have accessTier: auth_write, got: ${ACCESS_TIER:-empty}"
      else
        record PASS "SOC-5 write-tier" "Write adapter '${ADAPTER_LOCAL}' has accessTier: auth_write."
      fi
      ;;
    auth|search|feed|post-detail|comments|user|user-notes|notifications|unread|dm-list|follower-list|follow-list)
      # read adapters
      if [[ "$RO" == "true" ]]; then
        record PASS "SOC-5 readonly-mismatch" "Read adapter '${ADAPTER_LOCAL}' declares readOnly: true."
      else
        record FAIL "SOC-5 readonly-mismatch" "Read adapter '${ADAPTER_LOCAL}' must declare readOnly: true, got: ${RO:-empty}"
      fi
      ;;
  esac
fi

# ----- SOC-6: canonical adapter name + forbidden patterns -----
if [[ "$DOMAIN" == "social-media" && -n "$ADAPTER_LOCAL" ]]; then
  case "$ADAPTER_LOCAL" in
    # forbidden filter-variants
    feed-hot|feed-recommendation|feed-category|feed-following|feed-summary|note-summary)
      record FAIL "SOC-6 forbidden-name" "'${ADAPTER_LOCAL}' is a filter-variant of feed. Use the 'source' arg on 'feed'." ;;
    search-topic|search-hashtag|topics)
      record FAIL "SOC-6 forbidden-name" "'${ADAPTER_LOCAL}' is a filter-variant of search. Use the 'topic' arg on 'search'." ;;
    user-posts|user-favorites|user-likes|favorites|likes|hot-categories)
      record FAIL "SOC-6 forbidden-name" "'${ADAPTER_LOCAL}' is a filter-variant of user-notes. Use the 'which-list' arg on 'user-notes'." ;;
    auto-login|login-flow)
      record FAIL "SOC-6 forbidden-name" "'${ADAPTER_LOCAL}' is forbidden — login is the human's job (AGENTS.md #5). Use 'auth'." ;;
    *-debug|*-v2)
      record FAIL "SOC-6 forbidden-name" "'${ADAPTER_LOCAL}' is a debug/v2 variant. Delete before merge." ;;
    # P0 canonical
    auth|search|feed|post-detail|comments|user|user-notes|notifications|unread|like|favorite|comment-post|follow|post-create)
      record PASS "SOC-6 canonical-name" "'${ADAPTER_LOCAL}' is a P0 social-media adapter." ;;
    # P1 canonical
    post-delete|comment-delete|dm-list|dm-send|follow-list|follower-list)
      record PASS "SOC-6 canonical-name" "'${ADAPTER_LOCAL}' is a P1 social-media adapter." ;;
    *)
      record WARN "SOC-6 canonical-name" "'${ADAPTER_LOCAL}' is not in the canonical P0/P1 set. Justify or rename."
      ;;
  esac
fi

# ----- SOC-7: error envelope (error/hint/action) -----
# (Uses the same logic as the cross-domain Check 5 below; record here for domain context.)
if [[ "$DOMAIN" == "social-media" ]]; then
  if grep -qP "return\s*\{" "$ADAPTER" && grep -q "error\s*:" "$ADAPTER"; then
    if grep -q "hint\s*:" "$ADAPTER" && grep -q "action\s*:" "$ADAPTER"; then
      record PASS "SOC-7 error-envelope" "Adapter returns error/hint/action triple."
    else
      record WARN "SOC-7 error-envelope" "Adapter returns errors but does not consistently include 'hint' and 'action'."
    fi
  else
    record WARN "SOC-7 error-envelope" "No error-return pattern found. Verify error paths use the 10-code enum."
  fi
fi

# ----- SOC-8: recommendedNextActions (auth exempt) -----
if [[ "$DOMAIN" == "social-media" ]]; then
  if grep -q "recommendedNextActions" "$ADAPTER"; then
    record PASS "SOC-8 next-actions" "recommendedNextActions present."
  else
    case "$ADAPTER_LOCAL" in
      auth) record PASS "SOC-8 next-actions" "'auth' is exempt from recommendedNextActions." ;;
      *) record WARN "SOC-8 next-actions" "Adapter does not populate recommendedNextActions. Agents need this to chain calls." ;;
    esac
  fi
fi

# ----- SOC-9: pagination object in list adapters -----
if [[ "$DOMAIN" == "social-media" ]]; then
  case "$ADAPTER_LOCAL" in
    search|feed|user-notes|comments|notifications)
      if grep -q "pagination" "$ADAPTER"; then
        record PASS "SOC-9 pagination" "List adapter declares pagination object."
      else
        record WARN "SOC-9 pagination" "List adapters must return a 'pagination' object. See contract §6.3."
      fi
      ;;
  esac
fi

# ----- SOC-10: authStatus literal in source -----
if [[ "$DOMAIN" == "social-media" ]]; then
  if grep -q "authStatus" "$ADAPTER"; then
    record PASS "SOC-10 auth-status" "Source contains 'authStatus' literal."
  else
    record FAIL "SOC-10 auth-status" "Every return must include authStatus: anonymous|auth_read|auth_write."
  fi
fi

# ----- SOC-11: URL constant in first 50 lines -----
# (Same header-grep as the cross-domain Check 1; record SOC-11 for the domain.)
if [[ "$DOMAIN" == "social-media" ]]; then
  SOC11_HEADER="$CODE_WINDOW"
  if printf '%s' "$SOC11_HEADER" | grep -Eq "(const|let|var)\s+[A-Z_]*URL[A-Z_]*\s*=\s*['\"]https?://"; then
    record PASS "SOC-11 url-constant" "Destination URL constant declared in first 50 lines."
  else
    record FAIL "SOC-11 url-constant" "First 50 lines must declare const HOME_URL = 'https://...'."
  fi
  unset SOC11_HEADER
fi

# ----- SOC-12: no hardcoded credentials -----
if [[ "$DOMAIN" == "social-media" ]]; then
  if grep -qP "(password\s*=|passwd\s*=|api_key\s*=|secret\s*=|Bearer\s+[A-Za-z0-9+/=]{20,})" "$ADAPTER"; then
    record FAIL "SOC-12 no-creds" "Adapter source may contain hardcoded credentials. Remove or read from env."
  else
    record PASS "SOC-12 no-creds" "No hardcoded credentials detected."
  fi
fi

# ----- SOC-13: per-note token cache evidence (WARN) -----
if [[ "$DOMAIN" == "social-media" ]]; then
  case "$ADAPTER_LOCAL" in
    post-detail|comments|like|favorite|comment-post|feed|search|user-notes)
      if grep -qE "(xsecToken|xsec_token|noteContext|noteContextCache|cacheNoteContext)" "$ADAPTER"; then
        record PASS "SOC-13 token-cache" "Source shows per-note token cache logic."
      else
        record WARN "SOC-13 token-cache" "No per-note token (xsecToken/noteContext) logic found. Static check cannot verify runtime behavior."
      fi
      ;;
  esac
fi


# ----- Check 1: URL constant in first 50 code lines (after @meta) -----
HEADER="$CODE_WINDOW"
if printf '%s' "$HEADER" | grep -Eq "(const|let|var)\s+[A-Z_]*URL[A-Z_]*\s*=\s*['\"]https?://"; then
  record PASS url-declared "Destination URL constant declared in first 50 lines."
elif printf '%s' "$HEADER" | grep -Eq "https?://[a-zA-Z0-9.-]+"; then
  record WARN url-declared "URL appears in first 50 lines but not as a named constant. Prefer 'const HOME_URL = ...'."
else
  record FAIL url-declared "No destination URL constant in first 50 lines. Required: const HOME_URL = 'https://...';"
fi

# ----- PHR-3: URL constant contains dbKey slug -----
if [[ "$DOMAIN" == "pharma-data" && -n "$DBKEY" && "$DBKEY" != "null" ]]; then
  KIND_VAL="$(meta_get '.kind')"
  if [[ "$KIND_VAL" == "helper" ]]; then
    record PASS "PHR-3 url-constant" "Helper adapter (kind: helper) does not require a dbKey URL slug."
  elif printf '%s' "$HEADER" | grep -Eq "https?://[^'\"]*/${DBKEY}"; then
    record PASS "PHR-3 url-constant" "URL constant contains /${DBKEY}."
  else
    record FAIL "PHR-3 url-constant" "First 50 lines must contain a URL with /${DBKEY} slug."
  fi
fi

# ----- Check 2: @meta required fields -----
if [[ -n "$META_JSON" ]]; then
  for field in name description domain args capabilities readOnly example; do
    if meta_has "$field"; then
      record PASS "meta-field-${field}" "@meta.${field} is present."
    else
      record FAIL "meta-field-${field}" "@meta is missing required field: ${field}"
    fi
  done

  # pharma-data: dbKey and authStatus are required @meta fields
  if [[ "$DOMAIN" == "pharma-data" ]]; then
    for pfield in dbKey authStatus; do
      if meta_has "$pfield"; then
        record PASS "meta-field-${pfield}" "@meta.${pfield} is present."
      else
        record FAIL "meta-field-${pfield}" "@meta is missing required field: ${pfield} (pharma-data contract)"
      fi
    done
  fi

  # social-media: accessTier and intent are required @meta fields
  if [[ "$DOMAIN" == "social-media" ]]; then
    for sfield in accessTier intent; do
      if meta_has "$sfield"; then
        record PASS "meta-field-${sfield}" "@meta.${sfield} is present."
      else
        record FAIL "meta-field-${sfield}" "@meta is missing required field: ${sfield} (social-media contract)"
      fi
    done
  fi

  # name must be <site>/<adapter>
  if [[ -n "$NAME" && "$NAME" != */* ]]; then
    record FAIL meta-name-format "@meta.name must be '<site>/<adapter>', got: ${NAME}"
  fi

  # example must look like a bb-browser site command
  EXAMPLE="$(meta_get '.example')"
  if [[ -n "$EXAMPLE" && "$EXAMPLE" != *"bb-browser site"* ]]; then
    record WARN meta-example-format "@meta.example does not look like 'bb-browser site ...'."
  fi
fi

# ----- Check 3: adapter name not in forbidden list (ecommerce only) -----
if [[ "$DOMAIN" == "ecommerce" && -n "$ADAPTER_LOCAL" ]]; then
  case "$ADAPTER_LOCAL" in
    search-by-*|search-with-*|search-filter|search-filters|search-plan)
      record FAIL forbidden-name \
        "Adapter name '${ADAPTER_LOCAL}' is a filter-variant of search. Contract forbids this. Fold filters into search arguments."
      ;;
    cart-summary)
      record FAIL forbidden-name \
        "'cart-summary' is forbidden. Merge into 'cart-list' (return both summary and items)."
      ;;
    order-create|submit-order|auto-purchase|regular-buy|auto-*|*-debug|*-debug.js)
      record FAIL forbidden-name \
        "Adapter name '${ADAPTER_LOCAL}' is forbidden by ecommerce contract (orchestration / submit / debug variant)."
      ;;
    auth|search|product|cart-list|cart-add|cart-remove|checkout-preview|order-list|order-detail)
      record PASS canonical-name "'${ADAPTER_LOCAL}' is a P0 canonical adapter."
      ;;
    switch-store|coupon-list|coupon-claim|address-list|order-cancel|logistics)
      record PASS canonical-name "'${ADAPTER_LOCAL}' is a P1 canonical adapter."
      ;;
    *)
      record WARN unknown-name \
        "'${ADAPTER_LOCAL}' is not in the canonical P0/P1 set. Justify or rename."
      ;;
	  esac
fi

# ----- Check 3b: pharma-data readOnly enforcement -----
if [[ "$DOMAIN" == "pharma-data" && -n "$META_JSON" ]]; then
  RO="$(meta_get '.readOnly')"
  if [[ "$RO" != "true" ]]; then
    record FAIL "PHR-readonly" "Pharma-data adapters must be readOnly: true. Got: ${RO:-empty}"
  else
    record PASS "PHR-readonly" "Adapter declares readOnly: true (pharma-data requirement)."
  fi
fi

# ----- Check 4: write-capable adapter declares readOnly: false -----
if [[ -n "$META_JSON" ]]; then
  RO="$(meta_get '.readOnly')"
  case "$ADAPTER_LOCAL" in
    cart-add|cart-remove|coupon-claim|order-cancel)
      if [[ "$RO" == "true" ]]; then
        record FAIL readonly-mismatch \
          "Adapter '${ADAPTER_LOCAL}' mutates state but @meta.readOnly is true."
      fi
      ;;
  esac
fi

# ----- Check 5: error envelope (error/hint/action) -----
if grep -Eq "return\s*{[^}]*error\s*:" "$ADAPTER"; then
  if grep -Eq "hint\s*:" "$ADAPTER" && grep -Eq "action\s*:" "$ADAPTER"; then
    record PASS error-envelope "Adapter returns error/hint/action triple somewhere."
  else
    record WARN error-envelope \
      "Adapter returns errors but does not consistently include 'hint' and 'action' fields. Required by contract."
  fi
fi

# ----- Check 6: constraint-tracking trio (only for adapters that take filters) -----
case "$ADAPTER_LOCAL" in
  search|cart-list|order-list)
    if grep -q "requestedConstraints" "$ADAPTER" \
        && grep -q "executedConstraints" "$ADAPTER" \
        && grep -q "deferredConstraints" "$ADAPTER"; then
      record PASS constraint-tracking "Constraint trio (requested/executed/deferred) is present."
    else
      record WARN constraint-tracking \
        "List adapters should populate requestedConstraints / executedConstraints / deferredConstraints. See contract."
    fi
    ;;
esac

# ----- Check 7: recommendedNextActions for happy path -----
if grep -q "recommendedNextActions" "$ADAPTER"; then
  record PASS next-actions "recommendedNextActions present."
else
  case "$ADAPTER_LOCAL" in
    auth) ;;  # not required for read-only state checks
    *) record WARN next-actions "Adapter does not populate recommendedNextActions. Agents need this to chain calls." ;;
  esac
fi

# ----- Check 8: pagination shape for list adapters -----
case "$ADAPTER_LOCAL" in
  search|order-list|cart-list)
    if grep -q "pagination" "$ADAPTER"; then
      record PASS pagination "List adapter declares pagination object."
    else
      record WARN pagination "List adapters must return a 'pagination' object. See contract for shape."
    fi
    ;;
esac

# ----- Output -----
if [[ "$JSON_OUT" == 1 ]]; then
  printf '{\n  "adapter": "%s",\n  "domain": "%s",\n  "summary": {"pass": %d, "warn": %d, "fail": %d},\n  "results": [\n' \
    "$ADAPTER" "$DOMAIN" "$PASS" "$WARN" "$FAIL"
  first=1
  for entry in "${RESULTS[@]+"${RESULTS[@]}"}"; do
    IFS=$'\t' read -r level check msg <<<"$entry"
    [[ $first -eq 0 ]] && printf ',\n'
    printf '    {"level": "%s", "check": "%s", "message": %s}' \
      "$level" "$check" "$(printf '%s' "$msg" | jq -Rs .)"
    first=0
  done
  printf '\n  ]\n}\n'
else
  printf '\n  bb-eval  %s\n' "$ADAPTER"
  printf '  domain   %s\n' "$DOMAIN"
  printf '  adapter  %s\n\n' "${ADAPTER_LOCAL:-?}"
  for entry in "${RESULTS[@]+"${RESULTS[@]}"}"; do
    IFS=$'\t' read -r level check msg <<<"$entry"
    case "$level" in
      PASS) printf '  \033[32m✓\033[0m  %-22s %s\n' "$check" "$msg" ;;
      WARN) printf '  \033[33m!\033[0m  %-22s %s\n' "$check" "$msg" ;;
      FAIL) printf '  \033[31m✗\033[0m  %-22s %s\n' "$check" "$msg" ;;
    esac
  done
  printf '\n  %d pass  %d warn  %d fail\n\n' "$PASS" "$WARN" "$FAIL"
fi

[[ $FAIL -eq 0 ]] && exit 0 || exit 1
