# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Binary
*.exe

# Environment
.env
.env.*

# Temporary / scratch files at repo root
# Convention used during development: leading-underscore filenames
# are throwaway scripts (e.g. _fix_yaopinjiage.py, _test_eval.py)
# and must not be committed.
/_*.py
/_*.sh
/_*.js
/_*.md
/_*.txt

# Grok Build session raw logs (high-value files kept: PRD, brief, prompt, transcript)
docs/sessions/*/events.jsonl
docs/sessions/*/chat_history.jsonl
docs/sessions/*/updates.jsonl
docs/sessions/*/session-trace.tar.gz
docs/sessions/*/summary.json
docs/sessions/*/signals.json
docs/sessions/*/system_prompt.txt
.grok-evolver-run.log
